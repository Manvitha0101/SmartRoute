# Database
DATABASE_URL="postgresql://user:password@localhost:5433/smartroute"

# JWT — use a long random string (min 32 chars) for secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your_access_token_secret_here"
JWT_REFRESH_SECRET="your_refresh_token_secret_here"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Server
PORT=3000
NODE_ENV="development"

# ETA Microservice (Python FastAPI — configured in Feature 6)
ETA_SERVICE_URL="http://localhost:8000"
